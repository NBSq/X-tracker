# Required only for live mode
X_BEARER_TOKEN=
OPENAI_API_KEY=

# Optional in both modes. Set both values to enable Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# App settings
DATABASE_PATH=x_narrative_tracker.sqlite3
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=mock
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_MAX_POST_LENGTH=600
OPENAI_MIN_HYPE_SCORE=65
OPENAI_MIN_MOMENTUM_SCORE=50
OPENAI_MIN_CONFIDENCE=6
OPENAI_DAILY_REQUEST_LIMIT=100
OPENAI_CACHE_TTL_HOURS=24
OPENAI_FALLBACK_TO_MOCK=true
OPENAI_STORE_RESPONSES=false
FETCH_INTERVAL_SECONDS=900
HYPE_ALERT_THRESHOLD=25
POSTS_PER_ACCOUNT=10
RSS_ARTICLES_PER_FEED=10
OUTCOME_EVALUATION_HOURS=24
OUTCOME_EVALUATION_WINDOWS=24,72,168
OUTCOME_SUCCESS_THRESHOLD=10
OUTCOME_FAILURE_THRESHOLD=-10
HISTORY_GROWTH_THRESHOLD=20
HISTORY_MINIMUM_ACTIVITY=2

# Multi-source ingestion and deduplication
CONTENT_SOURCES_FILE=config/sources.json
SOURCE_ENABLED=true
SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_MAX_RETRIES=2
SOURCE_DEFAULT_INTERVAL_SECONDS=300
SOURCE_FAILURE_BACKOFF_SECONDS=600
SOURCE_MAX_ITEMS_PER_FETCH=100
DEDUPLICATION_ENABLED=true
DEDUPLICATION_TIME_WINDOW_HOURS=24
DEDUPLICATION_TITLE_SIMILARITY_THRESHOLD=0.82
DEDUPLICATION_BODY_SIMILARITY_THRESHOLD=0.88
DEDUPLICATION_MIN_SHARED_ENTITIES=1
DEDUPLICATION_CROSS_SOURCE_ONLY=false
EVENT_UPDATE_NOTIFICATIONS=true
EVENT_UPDATE_MIN_NEW_SOURCES=2
EVENT_UPDATE_MIN_HYPE_CHANGE=10
EVENT_UPDATE_MIN_MOMENTUM_CHANGE=10
EVENT_UPDATE_COOLDOWN_MINUTES=30
SOURCE_ALERT_AFTER_FAILURES=3
SOURCE_FAILURE_ALERT_COOLDOWN_MINUTES=60
SOURCE_RECOVERY_NOTIFICATIONS=true

# Narrative Relationship Graph
GRAPH_RECENCY_HALF_LIFE_DAYS=14
GRAPH_MIN_EDGE_WEIGHT=0.05
GRAPH_MIN_NODE_WEIGHT=0.05
GRAPH_AI_RELATIONSHIP_MIN_CONFIDENCE=0.75
GRAPH_DEFAULT_PERIOD_DAYS=30
GRAPH_MAX_NODES=250

# Signal Quality Analytics
QUALITY_CALCULATION_VERSION=1
QUALITY_MINIMUM_EVIDENCE=2
QUALITY_MINIMUM_SAMPLE_SIZE=5
QUALITY_WEIGHT_OUTCOME=0.25
QUALITY_WEIGHT_CALIBRATION=0.15
QUALITY_WEIGHT_SOURCE_RELIABILITY=0.15
QUALITY_WEIGHT_EVIDENCE=0.10
QUALITY_WEIGHT_SOURCE_DIVERSITY=0.10
QUALITY_WEIGHT_TIMELINESS=0.10
QUALITY_WEIGHT_RULE_PRECISION=0.05
QUALITY_WEIGHT_WATCHLIST_RELEVANCE=0.05
QUALITY_WEIGHT_AI_AGREEMENT=0.05
QUALITY_EXCELLENT_THRESHOLD=85
QUALITY_STRONG_THRESHOLD=70
QUALITY_MODERATE_THRESHOLD=55
QUALITY_WEAK_THRESHOLD=40
QUALITY_TIMELINESS_EXCELLENT_MINUTES=5
QUALITY_TIMELINESS_GOOD_MINUTES=15
QUALITY_TIMELINESS_WEAK_MINUTES=60
QUALITY_CHANGE_SIGNIFICANCE=5
