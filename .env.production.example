# Copy to .env on the production host. Never commit the populated file.

# Optional integrations. Leave blank to keep them disabled.
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
X_BEARER_TOKEN=

# Safe production defaults
AI_PROVIDER=mock
OPENAI_FALLBACK_TO_MOCK=true
TRACKER_ENABLED=true
FETCH_INTERVAL_SECONDS=900
HOST_PORT=8000
BIND_ADDRESS=127.0.0.1
LOG_FORMAT=json
LOG_LEVEL=INFO
LOG_INCLUDE_TIMESTAMP=true

# Graceful shutdown and observability
TRACKER_SHUTDOWN_TIMEOUT_SECONDS=30
OBSERVABILITY_SNAPSHOT_ENABLED=true
OBSERVABILITY_SNAPSHOT_INTERVAL_MINUTES=15
OBSERVABILITY_SNAPSHOT_RETENTION_DAYS=30
REPORT_SCHEDULER_ENABLED=true
REPORT_SCHEDULER_POLL_SECONDS=60
REPORT_DEFAULT_TIMEZONE=UTC
REPORT_MAX_RESULTS=50
REPORT_CSV_RETENTION_DAYS=30
REPORT_AI_SUMMARY_ENABLED=false
REPORT_OUTPUT_DIR=exports/scheduled_reports
